+            'status',
+            $url !== ''
+                ? 'URL CCTV disimpan. Dashboard Online kini aktif untuk lokasi ini.'
+                : 'URL CCTV dihapus. Dashboard Online untuk lokasi ini dinonaktifkan.'
+        );
+    }
