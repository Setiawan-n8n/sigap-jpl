APP_NAME="SIGAP-JPL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/data/database.sqlite

QUEUE_CONNECTION=database

SESSION_DRIVER=file
CACHE_STORE=file

DETECTOR_SERVICE_URL=http://detector:8001
DETECTOR_CALLBACK_SECRET=change-me-secret
DANGER_DWELL_SECONDS=5

# Akun admin dibuat/diperbarui otomatis saat container start (lihat
# app/Console/Commands/EnsureAdminUser.php). Default di bawah HANYA untuk
# uji coba lokal -- WAJIB diganti saat deploy produksi.
ADMIN_EMAIL=admin@sigap-jpl.local
ADMIN_PASSWORD=ubah-password-ini
ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# Pengiriman Email (dipakai fitur reset password)
# -----------------------------------------------------------------------------
# Default "log": email TIDAK benar-benar dikirim, tapi ditulis ke
# storage/logs/laravel.log. Berguna untuk menguji alur reset tanpa SMTP.
#
# Untuk PRODUKSI, ganti MAIL_MAILER=smtp dan isi kredensial SMTP asli di bawah.
# Contoh Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_USERNAME=<email>, MAIL_PASSWORD=<App Password 16 digit dari Google>.
#
# PENTING: pastikan APP_URL di atas benar (mis. https://sigap-jpl.batimulia.com)
# karena tautan reset di email dibuat berdasarkan APP_URL.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@sigap-jpl.batimulia.com"
MAIL_FROM_NAME="${APP_NAME}"
